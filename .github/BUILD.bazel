load("@rules_shell//shell:sh_test.bzl", "sh_test")

filegroup(
    name = "workflows",
    srcs = glob(["workflows/*.yml"]),
)

sh_test(
    name = "actionlint",
    srcs = ["actionlint.sh"],
    args = [
        "--bin",
        "$(rlocationpath //tools:actionlint)",
        "--config",
        "$(rlocationpath :actionlint.yaml)",
        "--shellcheck",
        "$(rlocationpath //tools:shellcheck)",
        "--",
        "$(rlocationpaths :workflows)",
    ],
    data = [
        ":actionlint.yaml",
        ":workflows",
        "//tools:actionlint",
        "//tools:shellcheck",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Offline: the audits that query the GitHub API (impostor commits, known
# vulnerable actions) need network access and a token, which a test must not
# depend on.
sh_test(
    name = "zizmor",
    srcs = ["zizmor.sh"],
    args = [
        "--bin",
        "$(rlocationpath //tools:zizmor)",
        "--",
        "$(rlocationpath :dependabot.yml)",
        "$(rlocationpaths :workflows)",
    ],
    data = [
        ":dependabot.yml",
        ":workflows",
        "//tools:zizmor",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
