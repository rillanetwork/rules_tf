module(
    name = "rules_tf",
    # The provider mirror resolves in the module extension and records the
    # result as extension facts, which Bazel gained in 9.0.
    bazel_compatibility = [">=9.0.0"],
    repo_name = "rules_tf",
)

bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "package_metadata", version = "0.0.5")
bazel_dep(name = "rules_python", version = "1.8.5")

bazel_dep(name = "buildifier_prebuilt", version = "8.0.1", dev_dependency = True)
bazel_dep(name = "rules_multitool", version = "1.11.1", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "rules_bazel_integration_test", version = "0.37.1", dev_dependency = True)

# Bazel binaries for the //tests integration suites.
bazel_binaries = use_extension(
    "@rules_bazel_integration_test//:extensions.bzl",
    "bazel_binaries",
    dev_dependency = True,
)
bazel_binaries.download(version_file = "//:.bazelversion")
use_repo(bazel_binaries, "bazel_binaries", "bazel_binaries_bazelisk", "build_bazel_bazel_.bazelversion")

# See the patch header. Root-only, so it does not reach consumers.
single_version_override(
    module_name = "rules_multitool",
    patch_strip = 1,
    patches = ["//patches:rules_multitool_transitive_hubs.patch"],
)

# actionlint + shellcheck binaries for the //.github:actionlint workflow linter.
# dev_dependency keeps this out of the dependency graph resolved by consumers.
multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool", dev_dependency = True)
multitool.hub(lockfile = "//tools/multitool:lock.json")
use_repo(multitool, "multitool")

tf = use_extension("@rules_tf//tf:extensions.bzl", "tf_repositories")
use_repo(
    tf,
    "tf_toolchains",
)

register_toolchains(
    "@tf_toolchains//:all",
)

# Development-only: autoconfigures a git toolchain from the system git, used by
# //tf/releasing to generate release notes. Previously set up in
# WORKSPACE.bzlmod, which Bazel 9 no longer reads.
git_configure = use_extension(
    "@rules_tf//tf/toolchains/git:git_configure.bzl",
    "git_configure",
    dev_dependency = True,
)
use_repo(git_configure, "rules_tf_git")

register_toolchains(
    "@rules_tf_git//:git_auto_toolchain",
    "//tf/toolchains/git:git_missing_toolchain",
    dev_dependency = True,
)
