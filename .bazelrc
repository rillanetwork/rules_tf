# This file contains options passed to Bazel when running tests.
# They are used by CI and by non-Bazel test scripts.

build:ci --verbose_failures
build:ci --sandbox_debug
build:ci --spawn_strategy=standalone
build:ci --genrule_strategy=standalone
test:ci --test_strategy=standalone

test --test_output=errors

# A test action's environment is scrubbed, so the nested Bazel that the
# integration tests drive would run tflint --init unauthenticated against the
# GitHub releases API and hit its 60-per-hour anonymous quota. Forward the
# token when the caller has one; unset, this is a no-op.
test --test_env=GITHUB_TOKEN

# Hides the child modules under tests/ from target expansion while leaving
# their files globbable from //tests, which .bazelignore would not. To update:
# `bazel run @rules_bazel_integration_test//tools:update_deleted_packages --
#  --exclude_dir .bazelbsp`
build --deleted_packages=tests/bcr,tests/bcr/tf,tests/bcr/tf/modules/mod-a,tests/bcr/tf/modules/mod-remote,tests/bcr/tf/modules/multi_provider,tests/bcr/tf/root-modules/root-mod-a,tests/bcr/tf/root-modules/root-mod-multi-provider,tests/bcr/tf/root-modules/root-mod-newrand,tests/bcr/tf/root-modules/root-mod-remote,tests/bcr_facts,tests/bcr_facts/tf/root-modules/root-mod-facts,tests/bcr_mirror_json,tests/bcr_mirror_json/tf,tests/bcr_mirror_json/tf/root-modules/root-mod-mirror-json,tests/bcr_tofu,tests/bcr_tofu/tf,tests/bcr_tofu/tf/root-modules/root-mod-tofu,tests/bcr_verified,tests/bcr_verified/tf/root-modules/root-mod-verified
query --deleted_packages=tests/bcr,tests/bcr/tf,tests/bcr/tf/modules/mod-a,tests/bcr/tf/modules/mod-remote,tests/bcr/tf/modules/multi_provider,tests/bcr/tf/root-modules/root-mod-a,tests/bcr/tf/root-modules/root-mod-multi-provider,tests/bcr/tf/root-modules/root-mod-newrand,tests/bcr/tf/root-modules/root-mod-remote,tests/bcr_facts,tests/bcr_facts/tf/root-modules/root-mod-facts,tests/bcr_mirror_json,tests/bcr_mirror_json/tf,tests/bcr_mirror_json/tf/root-modules/root-mod-mirror-json,tests/bcr_tofu,tests/bcr_tofu/tf,tests/bcr_tofu/tf/root-modules/root-mod-tofu,tests/bcr_verified,tests/bcr_verified/tf/root-modules/root-mod-verified

# Import a git-ignored .bazelrc.local file, if it exists.
try-import %workspace%/.bazelrc.local
