module(
    name = "rules_tf_bcr_tofu_tests",
    version = "0.0.1",
)

bazel_dep(name = "rules_tf", version = "", repo_name = "rules_tf")
local_path_override(
    module_name = "rules_tf",
    path = "../..",
)

tf = use_extension("@rules_tf//tf:extensions.bzl", "tf_repositories")

# The tofu toolchain has its own download rule and its own default registry
# (registry.opentofu.org). This workspace exercises the same mirror features
# the terraform suites cover, against that rule and that registry.
tf.download(
    version = "1.9.1",
    tflint_version = "0.53.0",
    tfdoc_version = "0.19.0",
    use_tofu = True,
    mirror = [
        # Exact pins, including a second version of one source.
        "hashicorp/random:3.3.2",
        "hashicorp/random:3.1.3",
        "hashicorp/null:3.1.1",
        # A constraint, resolved against registry.opentofu.org's version list.
        # Bounded above so the selection stays stable: must pick 3.4.0, the
        # highest 3.x, rather than any of the 4.x that exist.
        "hashicorp/tls:>= 3.0.0, < 4.0.0",
    ],
)

use_repo(tf, "tf_toolchains")

register_toolchains(
    "@tf_toolchains//:all",
)
