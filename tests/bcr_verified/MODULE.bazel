module(
    name = "rules_tf_bcr_verified_tests",
    version = "0.0.1",
)

bazel_dep(name = "rules_tf", version = "", repo_name = "rules_tf")
local_path_override(
    module_name = "rules_tf",
    path = "../..",
)

tf = use_extension("@rules_tf//tf:extensions.bzl", "tf_repositories")

# Verified hashes with no lock file anywhere: every zh: hash this mirror is
# checked against comes from the `verified/` facts in the committed
# MODULE.bazel.lock, which //tf:providers_lock put there by running `terraform
# providers lock`. strict, so the build fails if any entry is uncovered --
# which is what makes this a real test of the facts rather than of the default
# warning.
tf.download(
    mirror = [
        # Two versions of one source, so the manifest needs two runs of the
        # lock command: a dependency lock holds one version per provider.
        "hashicorp/random:3.3.2",
        "hashicorp/random:3.1.3",
        "hashicorp/null:3.1.1",
        # A constraint, to prove the hashes are locked against the version the
        # extension selected rather than against the manifest text. Bounded
        # above so the selection stays stable as new versions ship.
        "hashicorp/tls:>= 4.0.0, < 4.0.5",
    ],
    provider_locks_strict = True,
    tfdoc_version = "0.19.0",
    tflint_version = "0.53.0",
    version = "1.9.5",
)
use_repo(tf, "tf_toolchains")

register_toolchains(
    "@tf_toolchains//:all",
)
