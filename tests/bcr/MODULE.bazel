module(
    name = "rules_tf_bcr_tests",
    version = "0.0.1",
)

bazel_dep(name = "rules_tf", version = "", repo_name = "rules_tf")
local_path_override(
    module_name = "rules_tf",
    path = "../..",
)

tf = use_extension("@rules_tf//tf:extensions.bzl", "tf_repositories")
tf.download(
    version = "1.9.5",
    tflint_version = "0.53.0",
    tfdoc_version = "0.19.0",
    use_tofu = False,
    # The unverified path: this suite is about resolution -- constraints,
    # prereleases, collapsing duplicates -- so it admits packages on the
    # registry's word and warns, which is the behaviour a registry publishing
    # no signatures leaves. Verification itself is covered by bcr_verified.
    provider_verification = "off",
    mirror = [
        "hashicorp/random:3.3.2",
        "hashicorp/random:3.6.0",
        "hashicorp/null:3.1.1",
        # Prerelease pin: exercises that the mirror accepts full semver
        # ('x.y.z-prerelease'), not just three numeric components.
        "hashicorp/null:3.2.4-alpha.2",
        # Version constraints resolve against the registry's published list.
        # Bounded above so the selected version stays stable as new ones ship:
        # this must pick 4.0.4, not the 4.0.5/4.0.6 that already exist.
        "hashicorp/tls:>= 4.0.0, < 4.0.5",
        # Pessimistic constraint: '~> 3.1.0' bounds the patch component, so
        # this picks the highest 3.1.x rather than the newest 3.x.
        "hashicorp/random:~> 3.1.0",
        # A second constraint on a source already constrained above: the
        # version listing must be fetched once and shared, and the two entries
        # selecting 4.0.4 must collapse to a single mirror entry.
        "hashicorp/tls:= 4.0.4",
    ],
)

use_repo(tf, "tf_toolchains")
register_toolchains(
    "@tf_toolchains//:all",
)
