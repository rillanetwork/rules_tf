load("@rules_tf//tf:def.bzl", "tf_module")
load("@rules_tf//tf_apply:defs.bzl", "tf_root_module")

tf_module(
    name = "root-mod-a",
    providers = {
        "random": "hashicorp/random:3.3.2",
        "terraform": "terraform.io/builtin/terraform",
    },
    tf_version = ">= 1.9, <= 1.10",
    deps = [
        "//tf/modules/mod-a",
    ],
    tflint_config = "//tf:tflint-custom-config",
)

tf_root_module(
    name = "root-mod-a",
    backend = {
        "local": {
            "path": "terraform.tfstate",
        },
    },
    module = ":root-mod-a",
    tfvars = {
        "input_var": "from-bazel-tfvars",
    },
)
