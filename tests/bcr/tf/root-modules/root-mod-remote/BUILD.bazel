load("@rules_tf//tf:def.bzl", "tf_module")
load("@rules_tf//tf_apply:defs.bzl", "tf_root_module")

tf_module(
    name = "root-mod-remote",
    tf_version = ">= 1.9, <= 1.10",
    deps = [
        "//tf/modules/mod-remote",
    ],
)

# Kept on the standalone macro so that path stays covered; the sibling
# root-mod-a declares the same targets through tf_module(root = True).
#
# Shares the module's name deliberately: tf_root_module only declares targets
# suffixed with ".init", ".plan" and so on, so nothing actually collides. That is
# invisible to buildifier, which cannot expand a macro.
# buildifier: disable=duplicated-name
tf_root_module(
    name = "root-mod-remote",
    backend = {
        "local": {
            "path": "terraform.tfstate",
        },
    },
    module = ":root-mod-remote",
)
