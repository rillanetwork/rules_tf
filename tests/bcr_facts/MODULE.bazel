module(
    name = "rules_tf_bcr_facts_tests",
    version = "0.0.1",
)

bazel_dep(name = "rules_tf", version = "", repo_name = "rules_tf")
local_path_override(
    module_name = "rules_tf",
    path = "../..",
)

# The facts in MODULE.bazel.lock are only honoured by the Bazel release that
# wrote them, so bumping //:.bazelversion means regenerating this lock file.
tf = use_extension("@rules_tf//tf:extensions.bzl", "tf_repositories")

# Every mirror entry names a registry host that does not resolve, and one is a
# constraint rather than a pin. The build only succeeds if the extension facts
# committed in MODULE.bazel.lock answer every question -- which version the
# constraint selects, where each package lives, and whether its hash was
# verified -- so that service discovery, the metadata request and the lock
# command never happen. What remains is the content-addressed package
# downloads, which --repository_cache can serve.
tf.download(
    mirror = [
        "unreachable.invalid/hashicorp/random:3.3.2",
        "unreachable.invalid/hashicorp/null:3.1.1",
        "unreachable.invalid/hashicorp/random:~> 3.1.0",
    ],
    tfdoc_version = "0.19.0",
    tflint_version = "0.53.0",
    use_tofu = False,
    version = "1.9.5",
)
use_repo(tf, "tf_toolchains")

register_toolchains(
    "@tf_toolchains//:all",
)
