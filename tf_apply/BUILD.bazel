load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

exports_files(
    glob([
        "*.bzl",
    ]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "standard_package",
    srcs = glob([
        "*.bzl",
    ]) + [
        "BUILD.bazel",
    ],
    visibility = [
        "//distro:__pkg__",
        "//tf_apply:__pkg__",
    ],
)

# Lets downstream gazelle resolve `@rules_tf//tf_apply:defs.bzl` to `//tf_apply:defs`;
# deps intentionally empty (see //tf:def).
bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
)

# Staged into the child modules under tests/, which resolve this module through
# a local_path_override and so need its sources on disk rather than its targets.
filegroup(
    name = "all_files",
    testonly = True,
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)
