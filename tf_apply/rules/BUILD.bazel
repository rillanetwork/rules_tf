load(":defs_test.bzl", "defs_test_suite")

exports_files(
    glob([
        "*.sh",
    ]),
)

exports_files(
    glob(
        ["*.bzl"],
        exclude = ["*_test.bzl"],
    ),
    visibility = ["//visibility:public"],
)

# The tests themselves are not distributed: they are the only .bzl files here
# that a consumer never loads, and they depend on bazel_skylib's unittest.
filegroup(
    name = "standard_package",
    srcs = glob(
        ["*.bzl"],
        exclude = ["*_test.bzl"],
    ) + [
        "BUILD.bazel",
    ],
    visibility = [
        "//distro:__pkg__",
        "//tf_apply:__pkg__",
    ],
)

defs_test_suite()

filegroup(
    name = "all_files",
    testonly = True,
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)
