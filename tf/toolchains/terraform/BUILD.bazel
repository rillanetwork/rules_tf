package(default_applicable_licenses = ["//:license"])

filegroup(
    name = "standard_package",
    srcs = [
        "BUILD.bazel",
    ] + glob([
        "*.bzl",
        "*.tpl",
    ]),
    visibility = [
        "//tf:__pkg__",
    ],
)

exports_files(
    glob([
        "*.bzl",
        "*.tpl",
    ]),
    visibility = [
        "//tf:__pkg__",
    ],
)

# Staged into the child modules under tests/, which resolve this module through
# a local_path_override and so need its sources on disk rather than its targets.
filegroup(
    name = "all_files",
    testonly = True,
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)
