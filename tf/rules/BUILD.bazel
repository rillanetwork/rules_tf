package(default_applicable_licenses = ["//:license"])

filegroup(
    name = "standard_package",
    srcs = [
        "BUILD.bazel",
    ] + glob([
        "*.bzl",
        "*.sh",
        "*.yml",
    ]),
    visibility = [
        "//tf:__pkg__",
    ],
)

exports_files(
    glob([
        "*.bzl",
    ]),
    visibility = [
        "//tf:__pkg__",
    ],
)

# The module-calls action's script and terraform-docs template, reached by
# label from the tf_module rule wherever it is instantiated.
exports_files(
    glob([
        "*.sh",
        "*.yml",
    ]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "all_files",
    testonly = True,
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)
