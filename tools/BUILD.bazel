load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_binary(
    name = "list_modules",
    srcs = ["list_modules.py"],
    main = "list_modules.py",
    visibility = ["//visibility:public"],
)

py_test(
    name = "list_modules_test",
    srcs = [
        "list_modules.py",
        "list_modules_test.py",
    ],
    imports = ["."],
    main = "list_modules_test.py",
)

py_library(
    name = "redact_plan_json_lib",
    srcs = ["redact_plan_json.py"],
    imports = ["."],
)

py_binary(
    name = "redact_plan_json",
    srcs = ["redact_plan_json.py"],
    main = "redact_plan_json.py",
    visibility = ["//visibility:public"],
)

py_test(
    name = "redact_plan_json_test",
    srcs = ["redact_plan_json_test.py"],
    data = glob(["testdata/sensitive_plan/**"]),
    main = "redact_plan_json_test.py",
    deps = [":redact_plan_json_lib"],
)

py_binary(
    name = "run",
    srcs = ["run.py"],
    main = "run.py",
    visibility = ["//visibility:public"],
    deps = [":redact_plan_json_lib"],
)

py_test(
    name = "run_test",
    srcs = [
        "run.py",
        "run_test.py",
    ],
    imports = ["."],
    main = "run_test.py",
    deps = [":redact_plan_json_lib"],
)

# Tool aliases sourced from multitool (see //tools/multitool:lock.json). These
# are dev-only: they resolve @multitool, a dev_dependency repo, so consumers of
# the ruleset must never depend on them. Used by //.github:actionlint and
# //.github:zizmor.
alias(
    name = "actionlint",
    actual = "@multitool//tools/actionlint",
    visibility = ["//.github:__pkg__"],
)

alias(
    name = "shellcheck",
    actual = "@multitool//tools/shellcheck",
    visibility = ["//.github:__pkg__"],
)

alias(
    name = "zizmor",
    actual = "@multitool//tools/zizmor",
    visibility = ["//.github:__pkg__"],
)
